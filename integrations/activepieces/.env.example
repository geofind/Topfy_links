# Copie para .env e preencha antes de subir o docker-compose.yml.
# NUNCA versionar o .env real (já coberto pelo .gitignore raiz: `.env`, `.env.*`).

# --- Segurança (gerar valores fortes, nunca reaproveitar de outro ambiente) ---
# AP_ENCRYPTION_KEY: chave hex de 256 bits (32 bytes = 64 chars hex). Ex.: openssl rand -hex 32
AP_ENCRYPTION_KEY=
# AP_JWT_SECRET: string aleatória longa. Ex.: openssl rand -hex 32
AP_JWT_SECRET=
AP_API_KEY=

# --- Ambiente ---
AP_ENVIRONMENT=prod
AP_FRONTEND_URL=http://localhost:8080
AP_EXECUTION_MODE=UNSANDBOXED

# --- Timeouts ---
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_TRIGGER_DEFAULT_POLL_INTERVAL=5
AP_FLOW_TIMEOUT_SECONDS=600

# --- Postgres interno do Activepieces (NÃO é o Supabase do CanalTopfy) ---
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=

# --- Redis ---
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379

# --- Telemetria/recursos opcionais ---
AP_TELEMETRY_ENABLED=false
AP_TOOL_SEARCH_ENABLED=false
